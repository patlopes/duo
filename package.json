{
  "name": "duo",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "icons": "node scripts/build-icons.mjs",
    "setup:webkit": "bash scripts/setup-webkit-linux.sh",
    "release": "node scripts/release.mjs",
    "serve:release": "node scripts/serve-release.mjs",
    "mascots": "node scripts/build-mascots.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@ionic/react": "^9.0.10",
    "@ionic/react-router": "^9.0.10",
    "@phosphor-icons/react": "^2.1.10",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "react-virtuoso": "^4.18.20",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
